{
  "lastChangelogVersion": "0.84.1",
  "theme": "rig",
  "externalEditor": "nvim",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "transport": "auto",
  "httpIdleTimeoutMs": 1800000,
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 122000,
    "keepRecentTokens": 20000
  },
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-mcp-adapter@2.23.0",
    "npm:@diegopetrucci/pi-openai-fast"
  ]
}
