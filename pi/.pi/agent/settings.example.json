{
  "skills": ["!**/council-mode/**","!**/reverse-engineer-anything/**"],
  "theme": "rig",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.2-sol",
  "npmCommand": ["bun"],
  "compaction": {
    "enabled": true
  },
  "pi-codex-fast": { "mode": "off" },
  "subagents": {
    "defaultModel": "openai/gpt-6.2-sol",
    "defaultSubagentOnlyExtensions": [
      "npm:@calesennett/pi-codex-fast@0.1.14"
    ]
  },
  "rigReview": {
    "low": [
      { "provider": "openai", "id": "gpt-6.2-sol", "thinkingLevel": "medium" },
      { "provider": "pi-sub-anthropic", "id": "claude-opus-5-5", "thinkingLevel": "medium" }
    ],
    "medium": [
      { "provider": "openai", "id": "gpt-6.2-sol", "thinkingLevel": "xhigh" },
      { "provider": "pi-sub-anthropic", "id": "claude-opus-5-5", "thinkingLevel": "xhigh" }
    ],
    "hard": [
      { "provider": "openai", "id": "gpt-6.2-astra", "thinkingLevel": "xhigh" },
      { "provider": "pi-sub-anthropic", "id": "claude-fable-5-2", "thinkingLevel": "xhigh" }
    ]
  },
  "rigReviewAdditional": {
    "low": [
      { "provider": "opencode-go", "id": "glm-5.3", "thinkingLevel": "low" },
      { "provider": "opencode-go", "id": "deepseek-v4-pro", "thinkingLevel": "low" }
    ],
    "medium": [
      { "provider": "opencode-go", "id": "glm-5.3", "thinkingLevel": "high" },
      { "provider": "opencode-go", "id": "deepseek-v4-pro", "thinkingLevel": "high" }
    ],
    "hard": [
      { "provider": "opencode-go", "id": "glm-5.3", "thinkingLevel": "max" },
      { "provider": "opencode-go", "id": "deepseek-v4-pro", "thinkingLevel": "max" }
    ]
  },
  "enableInstallTelemetry": false,
  "packages": [
    { "source": "npm:pi-subagents@latest", "skills": ["!skills/council-mode/**"], "prompts": [] },
    "npm:pi-web-access",
    "npm:@calesennett/pi-codex-fast@0.1.14",
    "npm:pi-sub-anthropic"
  ]
}
