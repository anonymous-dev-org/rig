{
  "theme": "rig",
  "npmCommand": ["bun"],
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "pi-fast": {
    "enabledByDefault": true
  },
  "subagents": {
    "defaultModel": "openai/gpt-6.1-sol",
    "defaultSubagentOnlyExtensions": [
      "npm:pi-fast@0.3.0"
    ],
    "agentOverrides": {
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "claude-code": {
        "disabled": true
      },
      "coding-partner": {
        "fast": false
      },
      "delegate": {
        "fast": false
      },
      "evidence-auditor": {
        "fast": false,
        "disabled": true
      },
      "oracle": {
        "fast": false,
        "disabled": true
      },
      "planner": {
        "fast": false,
        "disabled": true
      },
      "researcher": {
        "fast": false
      },
      "reviewer": {
        "fast": false,
        "disabled": true
      },
      "reviewer-api": {
        "fast": false,
        "disabled": true
      },
      "reviewer-data": {
        "fast": false,
        "disabled": true
      },
      "reviewer-quality": {
        "fast": false,
        "disabled": true
      },
      "reviewer-requirements": {
        "fast": false,
        "disabled": true
      },
      "reviewer-runtime": {
        "fast": false,
        "disabled": true
      },
      "reviewer-security": {
        "fast": false
      },
      "reviewer-ui": {
        "fast": false,
        "disabled": true
      },
      "scout": {
        "fast": false
      },
      "worker": {
        "fast": false
      }
    }
  },
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-subagents@latest",
    "npm:pi-web-access",
    "npm:pi-fast@0.3.0",
    "npm:pi-antigravity"
  ]
}
